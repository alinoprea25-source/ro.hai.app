        "city": { "type": "string", "enum": ["Cluj-Napoca", "București", "Timișoara", "Brașov", "Sibiu", "Iași"], "maxLength": 30 },
        "occupation": { "type": "string", "maxLength": 80 },
        "bio": { "type": "string", "maxLength": 300 },
        "interests": { "type": "array" },
        "activityPreferences": { "type": "array" },
