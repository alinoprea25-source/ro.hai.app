{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account record containing PII and account settings, readable only by the owner or an authorized administrator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 160 },
        "isAdultConfirmed": { "type": "boolean" },
        "hasCompletedOnboarding": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["unverified", "pending", "verified", "rejected"], "maxLength": 20 },
        "verificationNote": { "type": "string", "maxLength": 240 },
        "reconfirmationEnabled": { "type": "boolean" },
        "reconfirmationHoursBefore": { "type": "integer" },
        "reconfirmationFollowUp": { "type": "boolean" },
        "autoReleaseWaitlistSpot": { "type": "boolean" },
        "notificationsMatches": { "type": "boolean" },
        "notificationsActivities": { "type": "boolean" },
        "notificationsSafety": { "type": "boolean" },
        "accountStatus": { "type": "string", "enum": ["active", "suspended", "deleted"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "email",
        "isAdultConfirmed",
        "hasCompletedOnboarding",
        "verificationStatus",
        "reconfirmationEnabled",
        "reconfirmationHoursBefore",
        "reconfirmationFollowUp",
        "autoReleaseWaitlistSpot",
        "notificationsMatches",
        "notificationsActivities",
        "notificationsSafety",
        "accountStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public social and dating profile with zero PII (no email, phone, or private address).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
