      "type": "object",
      "properties": {
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ciphertext": { "type": "string", "minLength": 16, "maxLength": 4096 },
        "nonce": { "type": "string", "minLength": 12, "maxLength": 128 },
        "senderPublicKey": { "type": "string", "minLength": 20, "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "ciphertext", "nonce", "senderPublicKey", "createdAt"]
    },
    "NotificationRecord": {
      "title": "NotificationRecord",
      "description": "User-scoped notification item for plans, matches, and safety alerts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "body": { "type": "string", "minLength": 2, "maxLength": 400 },
        "type": { "type": "string", "maxLength": 40 },
        "read": { "type": "boolean" },
        "planId": { "type": "string", "maxLength": 128 },
        "activityId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "body", "type", "read", "createdAt", "updatedAt"]
    },
    "UserBlock": {
      "title": "UserBlock",
      "description": "User-controlled safety block relationship.",
      "type": "object",
      "properties": {
        "blockerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "blockedId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["blockerId", "blockedId", "createdAt"]
    },
    "SafetyReport": {
      "title": "SafetyReport",
      "description": "Abuse or safety report readable only by the reporter (for own report) or administrators.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["user", "activity", "comment", "review"], "maxLength": 20 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reason": { "type": "string", "minLength": 3, "maxLength": 100 },
        "details": { "type": "string", "maxLength": 600 },
        "status": { "type": "string", "enum": ["în analiză", "revizuit", "eliminat", "respins"], "maxLength": 20 },
        "appealStatus": { "type": "string", "enum": ["NONE", "PENDING", "GRANTED"], "maxLength": 20 },
        "appealNote": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "targetType", "targetId", "targetTitle", "reason", "details", "status", "appealStatus", "createdAt", "updatedAt"]
    },
    "ModerationAction": {
      "title": "ModerationAction",
      "description": "Admin-only audit log of moderation decisions.",
      "type": "object",
      "properties": {
        "moderatorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["comment", "review", "user", "activity", "dispute"], "maxLength": 20 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": { "type": "string", "enum": ["REMOVED", "DISMISSED_REPORT", "APPEAL_GRANTED", "DISPUTE_EXCUSED", "DISPUTE_UPHELD", "VERIFICATION_APPROVED", "VERIFICATION_REJECTED"], "maxLength": 30 },
        "reason": { "type": "string", "minLength": 3, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["moderatorId", "targetType", "targetId", "action", "reason", "createdAt"]
    },
    "VerificationRequest": {
      "title": "VerificationRequest",
      "description": "Private pose-selfie verification submission reviewed solely by administrators.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "poseId": { "type": "string", "enum": ["pose-peace-left", "pose-open-palm-chin", "pose-ok-right"], "maxLength": 40 },
        "storagePath": { "type": "string", "minLength": 5, "maxLength": 300 },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"], "maxLength": 20 },
        "reviewNote": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "poseId", "storagePath", "status", "createdAt", "updatedAt"]
    },
    "TrustedContact": {
      "title": "TrustedContact",
      "description": "Private emergency/trusted contact saved by a user for voluntary safety check-ins.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "relation": { "type": "string", "minLength": 2, "maxLength": 50 },
        "contactInfo": { "type": "string", "minLength": 3, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "relation", "contactInfo", "createdAt", "updatedAt"]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Server/console-managed administrator allowlist.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["admin", "moderator"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "createdAt"]
    }
  },
