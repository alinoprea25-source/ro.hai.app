        "showMeInDiscovery": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "name",
        "age",
        "city",
        "occupation",
        "bio",
        "interests",
        "activityPreferences",
        "photoKey",
        "lookingFor",
        "isVerified",
        "showMeInDiscovery",
        "createdAt",
        "updatedAt"
      ]
    },
    "DatingPreferences": {
      "title": "DatingPreferences",
