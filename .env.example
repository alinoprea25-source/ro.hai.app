# GEMINI_API_KEY: Server-side only (optional unless AI endpoints are used).
GEMINI_API_KEY=""

# APP_URL: Public base URL of the deployed web app (Cloud Run / Replit / custom domain).
APP_URL=""

# HAI_ADMIN_EMAILS: Optional comma-separated verified admin emails evaluated server-side.
HAI_ADMIN_EMAILS=""

# RevenueCat server-side secrets (NEVER prefix with NEXT_PUBLIC_ or commit real values)
REVENUECAT_SECRET_API_KEY=""
REVENUECAT_WEBHOOK_SECRET=""

# RevenueCat public SDK configuration (safe public app keys for mobile builds)
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID="hai_plus"
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=""
NEXT_PUBLIC_REVENUECAT_IOS_KEY=""

# Optional API base URL override when running Capacitor mobile shell against remote backend
NEXT_PUBLIC_API_BASE_URL=""

# Capacitor native shell configuration (used during `npx cap sync`)
CAPACITOR_SERVER_URL=""
CAPACITOR_ALLOW_CLEARTEXT="false"
CAPACITOR_DEBUG="false"

